# Optional server-only OpenRouteService key for road estimates and real OSM POI fallback.
# Without it, Live Mode uses clearly labeled straight-line distance only.
ORS_API_KEY=
# Optional Google Places API (New) key. Server only; rating matches are never invented.
GOOGLE_PLACES_API_KEY=
PORT=3001
# Set true or a hop count when running behind a trusted reverse proxy.
TRUST_PROXY=false
# Maximum Google Places requests per client IP per UTC day (keep low for demo keys).
GOOGLE_DAILY_REQUEST_LIMIT=40
# Optional shared rate-limit/cache store for multi-process deployments.
REDIS_URL=
# Optional replaceable provider endpoints for deployment.
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
ORS_URL=https://api.heigit.org/openrouteservice
POI_URL=https://api.heigit.org/openpoiservice/v0/pois
