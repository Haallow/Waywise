# Waywise production reverse proxy example.
# Replace waywise.example.com and certificate paths before enabling.

limit_req_zone $binary_remote_addr zone=waywise_api:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=waywise_conn:10m;

server {
    listen 80;
    server_name waywise.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name waywise.example.com;

    ssl_certificate /etc/letsencrypt/live/waywise.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/waywise.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://tile.openstreetmap.org https://*.openstreetmap.org; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.openstreetmap.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 24k;
    client_header_timeout 10s;
    client_body_timeout 15s;
    keepalive_timeout 15s;
    limit_conn waywise_conn 20;

    location /api/ {
        limit_req zone=waywise_api burst=10 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 45s;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
    }
}
